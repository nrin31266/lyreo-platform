# Browser-public configuration only. Vite bundles every VITE_* value into JavaScript.
# Never put provider API keys, DB passwords, R2 secret or Keycloak confidential secret here.

# Dev: Core runs directly on host.
# Self-host production Docker image uses an EMPTY base URL (same origin).
# API call paths already start with /api/v1, so setting this to /api would produce /api/api/v1.
VITE_API_BASE_URL=http://localhost:8080

# Dev direct Keycloak endpoint. Self-host production defaults to relative /auth behind edge.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=lyreo
VITE_KEYCLOAK_CLIENT_ID=lyreo-admin-web

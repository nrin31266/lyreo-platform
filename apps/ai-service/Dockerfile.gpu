# GPU image is separate so ordinary developers/CI never download CUDA/Qwen dependencies.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.12 python3-pip ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN python3.12 -m pip install --break-system-packages --no-cache-dir uv
COPY apps/ai-service/pyproject.toml apps/ai-service/uv.lock ./
RUN uv sync --locked --python python3.12 --extra qwen --no-dev --no-install-project

COPY apps/ai-service/app ./app
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
CMD ["python3.12","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8000"]

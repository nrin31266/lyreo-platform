# Lyreo AI Service runtime environment.
# FastAPI is an AI capability executor, not a business backend.

# ============================================================
# RUNTIME MODE
# ============================================================

# mock  = deterministic no-GPU runtime for normal dev/CI.
# local = load qwen-asr + Qwen3-ForcedAligner in this Python process.
AI_RUNTIME_MODE=mock

# Shared Core -> AI credential. scripts/init-dev-env.sh synchronizes the local value.
# This token authenticates the private service boundary; it is NOT a learner/admin token.
AI_SERVICE_INTERNAL_TOKEN=change-me-local-internal-token

# ============================================================
# QWEN LOCAL RUNTIME (used only when AI_RUNTIME_MODE=local)
# ============================================================

# Keep model identifiers configurable so model upgrades do not require business-code changes.
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B

# Typical NVIDIA local runtime. CPU is technically possible but not a production recommendation.
QWEN_DEVICE=cuda:0
QWEN_DTYPE=bfloat16

# Bound local inference memory/latency. Increase only after measuring GPU headroom.
QWEN_MAX_INFERENCE_BATCH_SIZE=8
QWEN_MAX_NEW_TOKENS=512

# ============================================================
# KOKORO LOCAL TTS (used when provider=LOCAL_KOKORO on /v1/tts)
# ============================================================

# Install the optional dependency group first: uv sync --extra kokoro
# Phonemization also needs the 'espeak-ng' system package:
#   Fedora/RHEL: sudo dnf install espeak-ng
#   Ubuntu/Debian: sudo apt-get install espeak-ng
#   macOS: brew install espeak-ng
# CPU is the sensible default for Kokoro; GPU adds no practical benefit at this size.
KOKORO_MODEL=hexgrad/Kokoro-82M
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_DEVICE=cpu
KOKORO_SAMPLE_RATE=24000

# Long text is chunked deterministically and concatenated with a fixed silence gap.
KOKORO_CHUNK_LIMIT_CHARS=450
KOKORO_CHUNK_GAP_MS=250

# ============================================================
# EXTERNAL PROVIDER ENDPOINTS
# ============================================================

# Credentials are NOT stored here in production. Core stores encrypted credentials and forwards
# the selected provider credential only over the private Core -> FastAPI request boundary.
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini native REST is used for capabilities such as TTS/multimodal; OpenAI-compatible endpoint
# can be used for generic LLM execution where supported.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ============================================================
# HTTP SAFETY
# ============================================================

# Upper guard for request metadata/body accepted by this service. Large media should be referenced
# by signed/internal object URL instead of embedding base64 into JSON.
MAX_REQUEST_BYTES=10485760

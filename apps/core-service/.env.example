# Lyreo Core Service environment.
# Copy to `.env`; do not commit the real file. Variables here are SERVER-SIDE only.

# ============================================================
# DATABASE
# ============================================================

# JDBC URL of the Lyreo business database. Dev PostgreSQL comes from compose.dev.yml.
DATABASE_URL=jdbc:postgresql://localhost:5432/lyreo_dev
DATABASE_USERNAME=lyreo
DATABASE_PASSWORD=lyreo_dev_password

# ============================================================
# KEYCLOAK / OIDC
# ============================================================

# Public issuer embedded in/expected from JWT `iss`.
# In local dev Keycloak is exposed directly on :8081.
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/lyreo

# JWK endpoint used to fetch signing keys. Usually follows the issuer in dev.
# In reverse-proxy production this can point to an INTERNAL Docker URL while
# KEYCLOAK_ISSUER_URI remains the public external issuer.
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/lyreo/protocol/openid-connect/certs

# ============================================================
# OBJECT STORAGE
# ============================================================

# local = filesystem adapter, zero credentials, easiest first-run dev.
# r2    = Cloudflare R2 through S3-compatible AWS SDK adapter.
STORAGE_MODE=local

# Used only when STORAGE_MODE=local. Relative to apps/core-service when following README commands.
LOCAL_STORAGE_ROOT=../../.data/storage

# --- Cloudflare R2 (required only when STORAGE_MODE=r2) ---
# Endpoint shape: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lyreo-dev
R2_REGION=auto

# ============================================================
# SERVER-SIDE SECRET ENCRYPTION
# ============================================================

# Base64 of 32 random bytes (AES-256-GCM root key) used to encrypt provider API keys in PostgreSQL.
# Generate: openssl rand -base64 32
# KEEP STABLE. Losing it means stored provider credentials cannot be decrypted.
MASTER_ENCRYPTION_KEY=

# ============================================================
# AI SERVICE
# ============================================================

AI_SERVICE_BASE_URL=http://localhost:8000

# Shared internal credential Core -> FastAPI. Never expose to Admin/Mobile.
# init-dev-env.sh generates/synchronizes a local value when placeholder is present.
AI_SERVICE_INTERNAL_TOKEN=change-me

# Maximum duration for one capability HTTP call. Lesson build itself is a background job,
# so this timeout does not keep a browser/mobile request open.
AI_SERVICE_TIMEOUT_SECONDS=300

# ============================================================
# OPTIONAL YOUTUBE SOURCE MATERIALIZATION
# ============================================================

# Disabled by default. When enabled, Core executes the external command below with ProcessBuilder
# to obtain an audio artifact for the Lesson ASR/alignment pipeline. User-facing playback remains
# a YouTube source reference. Install both yt-dlp and ffmpeg on the Core host/container first.
YOUTUBE_MEDIA_TOOL_ENABLED=false

# Executable name or absolute path. Do not put shell fragments/arguments here; Core does not invoke
# a shell and passes the source URL as a separate ProcessBuilder argument.
YOUTUBE_MEDIA_TOOL_COMMAND=yt-dlp

# Hard wall-clock limit for one materialization. Timeout/failure becomes a retryable Lesson step
# error where appropriate; it is not kept only in process memory.
YOUTUBE_MEDIA_TOOL_TIMEOUT_SECONDS=300

# ============================================================
# OPENAPI / SWAGGER
# ============================================================

# Controls availability of /v3/api-docs and /swagger-ui.html.
# Strictly disabled by default in base configuration (production-safe).
# Automatically enabled in development via application-dev.yml (SPRING_PROFILES_ACTIVE=dev).
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# ============================================================
# SPRING MODULITH EVENT RECOVERY
# ============================================================

# Off by default because automatic restart republish can be unsafe when multiple Core instances
# are alive. Enable only for a controlled single-instance deployment or after defining an
# explicit multi-instance event resubmission policy. This is unrelated to Lesson background jobs.
MODULITH_REPUBLISH_OUTSTANDING_ON_RESTART=false

# ============================================================
# BACKGROUND JOBS (PostgreSQL-backed queue)
# ============================================================

# Poll cadence for claimable QUEUED/RETRY_WAIT jobs.
JOB_POLL_INTERVAL_MS=1000

# How often expired leases are recovered after a worker/process crash.
JOB_RECOVER_INTERVAL_MS=30000

# Worker ownership lease. BackgroundJobWorker heartbeats independently from progress callbacks.
JOB_LEASE_SECONDS=60

# Starter worker handles a claimed batch sequentially. Do not increase blindly for GPU work.
JOB_CLAIM_BATCH_SIZE=5

# ============================================================
# API PROTECTION
# ============================================================

# Single-node Bucket4j token bucket. This is not a globally coordinated quota across replicas.
API_RATE_LIMIT_TOKENS_PER_MINUTE=120

# Bound Caffeine bucket cardinality to avoid unbounded memory use from arbitrary client keys.
API_RATE_LIMIT_MAX_CLIENT_KEYS=100000

# Browser CORS origins, comma-separated. Primarily Admin Web/dev tooling.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# LOCAL DEVELOPMENT BOOTSTRAP
# ============================================================

# `dev` enables the guarded internal endpoint used by Keycloak seed script to mirror dev users.
# Production must not run with this profile.
SPRING_PROFILES_ACTIVE=dev
DEV_BOOTSTRAP_TOKEN=lyreo-dev-bootstrap-token-change-me

SERVER_PORT=8080

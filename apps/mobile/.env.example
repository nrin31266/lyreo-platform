# EXPO_PUBLIC_* is compiled/bundled into the mobile app. It is NOT a secret store.

# Android Emulator reaches host machine via 10.0.2.2.
# For physical devices replace with LAN IP / HTTPS dev environment URL.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
EXPO_PUBLIC_KEYCLOAK_URL=http://10.0.2.2:8081
EXPO_PUBLIC_KEYCLOAK_REALM=lyreo
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=lyreo-mobile

{
  "expo": {
    "name": "Lyreo",
    "slug": "lyreo",
    "scheme": "lyreo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lyreo.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.lyreo.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Raleway",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/raleway/400Regular/Raleway_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/raleway/500Medium/Raleway_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/raleway/600SemiBold/Raleway_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/raleway/700Bold/Raleway_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/raleway/800ExtraBold/Raleway_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/raleway/400Regular/Raleway_400Regular.ttf",
              "./node_modules/@expo-google-fonts/raleway/500Medium/Raleway_500Medium.ttf",
              "./node_modules/@expo-google-fonts/raleway/600SemiBold/Raleway_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/raleway/700Bold/Raleway_700Bold.ttf",
              "./node_modules/@expo-google-fonts/raleway/800ExtraBold/Raleway_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "034046ac-1e1a-4a1a-b9ea-5a87eee0ca6b"
      }
    },
    "owner": "abc0905440632s-team"
  }
}

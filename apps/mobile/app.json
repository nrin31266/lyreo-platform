{
  "expo": {
    "name": "Lyreo",
    "slug": "lyreo",
    "scheme": "lyreo",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lyreo.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.lyreo.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}

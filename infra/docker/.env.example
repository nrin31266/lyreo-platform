# Docker/Compose infrastructure variables only.
# Core/AI/Admin/Mobile runtime variables live in their own .env files.

COMPOSE_PROJECT_NAME=lyreo

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_DB=lyreo_dev
POSTGRES_USER=lyreo
POSTGRES_PASSWORD=lyreo_dev_password
POSTGRES_PORT=5432

# Keycloak gets a separate database on the same PostgreSQL server in the starter topology.
KEYCLOAK_DB=lyreo_keycloak

# ============================================================
# KEYCLOAK CONTAINER BOOTSTRAP
# ============================================================
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-change-me

# Confidential service-account client secret. Never expose in browser/mobile env.
# `scripts/init-dev-env.sh` generates/synchronizes a stronger local value when placeholder remains.
LYREO_CORE_CLIENT_SECRET=lyreo-local-core-secret-change-me

# Public URL that Keycloak is exposed at in compose.prod.yml. Core validates JWT issuer against it.
# Local self-host starter uses the edge path /auth; replace with your real HTTPS URL/domain.
KEYCLOAK_PUBLIC_URL=http://localhost/auth

# Public edge port for compose.prod.yml starter.
EDGE_HTTP_PORT=80

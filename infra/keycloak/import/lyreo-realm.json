{
  "realm": "lyreo",
  "enabled": true,
  "displayName": "Lyreo",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Lyreo administration access"
      },
      {
        "name": "LEARNER",
        "description": "Lyreo learner access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lyreo-admin-web",
      "name": "Lyreo Admin Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://admin.lyreo.example/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://admin.lyreo.example",
        "http://localhost",
        "http://127.0.0.1"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "lyreo-mobile",
      "name": "Lyreo Mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "lyreo://auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "lyreo://auth/callback"
      }
    },
    {
      "clientId": "lyreo-core-service",
      "name": "Lyreo Core Service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${LYREO_CORE_CLIENT_SECRET}"
    }
  ],
  "defaultRoles": [
    "LEARNER"
  ]
}

# Script-only local bootstrap settings. This is separate from browser/mobile env.
KEYCLOAK_CONTAINER=lyreo-keycloak
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=lyreo

# Local bootstrap administrator. Never reuse these defaults in production.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-change-me

# Confidential Core service-account secret. init-dev-env.sh synchronizes this with
# infra/docker/.env and apps/core-service/.env.
LYREO_CORE_CLIENT_SECRET=lyreo-local-core-secret-change-me

# Idempotent local identities. Passwords are intentionally development-only.
KEYCLOAK_SEED_ADMIN_EMAIL=admin@local.test
KEYCLOAK_SEED_ADMIN_PASSWORD=Admin123!ChangeMe
KEYCLOAK_SEED_LEARNER_EMAIL=learner@local.test
KEYCLOAK_SEED_LEARNER_PASSWORD=Learner123!ChangeMe

# Optional convenience: when Core runs SPRING_PROFILES_ACTIVE=dev, script mirrors subjects
# into app_user through a guarded internal endpoint.
CORE_API_BASE_URL=http://localhost:8080
DEV_BOOTSTRAP_TOKEN=lyreo-dev-bootstrap-token-change-me

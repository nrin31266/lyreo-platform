# Optional operator settings for make data-ai-pilot. Copy to .env and uncomment only what you set.
# Provider credentials stay in this ignored local file or in the operator's shell environment.
# DEEPSEEK_KEY=

# DEEPSEEK, GEMINI_FLASH_LITE, GEMINI_31_FLASH_LITE, or GROQ_GPT_OSS.
# DATA_MAINTENANCE_MODEL=DEEPSEEK

# Set the date you verified the selected model's pricing and, for batch runs, a budget in USD.
# DATA_MAINTENANCE_PRICING_CONFIRMED_ON=
# DATA_MAINTENANCE_BUDGET_USD=

# Optional overrides. Relative paths resolve from the repository root.
# DATA_MAINTENANCE_AI_URL=http://localhost:8000
# DATA_MAINTENANCE_INPUT=.data/maintenance/pilot.jsonl
# DATA_MAINTENANCE_OUTPUT=.data/maintenance/pilot-results.json

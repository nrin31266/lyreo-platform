# Optional operator settings for make data-ai-pilot. Copy to tools/research/.env or set in the shell.
# Supply provider credentials separately through the operator shell when explicitly running paid work.

# DEEPSEEK, GEMINI_FLASH_LITE, GEMINI_31_FLASH_LITE, or GROQ_GPT_OSS.
# DATA_MAINTENANCE_MODEL=DEEPSEEK
# DATA_MAINTENANCE_PRICING_CONFIRMED_ON=
# DATA_MAINTENANCE_BUDGET_USD=
# DATA_MAINTENANCE_AI_URL=http://localhost:8000
# Paths are relative to the repository root.
# DATA_MAINTENANCE_INPUT=.data/maintenance/pilot.jsonl
# DATA_MAINTENANCE_OUTPUT=.data/maintenance/pilot-results.json

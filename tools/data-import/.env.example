# Data importer environment is intentionally separate from Core Service runtime secrets.

# ============================================================
# GRAMMAR / TOEIC DATASET
# ============================================================

# Dataset root expected by import_grammar.py and import_toeic.py.
# Relative paths are resolved from tools/data-import/. The default lands in repo-local .data/,
# which is ignored by Git and Docker build contexts.
DAUTOEIC_DATA_DIR=../../.data/datasets/toeic

# Shared project-owner archive used by make data-fetch when the local dataset is missing.
# Google Drive file-share URLs are downloaded through ephemeral `uvx gdown --fuzzy`.
# The archive must contain exactly one dataset root with:
#   grammar_data/
#   mock_test_data/
DAUTOEIC_DATA_URL=https://drive.google.com/file/d/1FQgEswv3hUmT0Wv8Tyy9Jl_p9iLfoLZs/view?usp=sharing

# Optional integrity pin. Leave blank until the team records the SHA-256 of the canonical archive.
# Once populated, scripts/fetch-data.sh refuses archives that do not match it.
DAUTOEIC_DATA_SHA256=

# ============================================================
# LEXICON SOURCE DATA
# ============================================================

# Lexicon is a separate pipeline and has NOT been downloaded/scraped as part of the TOEIC dataset.
# Populate these only after obtaining the intended Kaikki/Wiktextract JSONL exports.
KAIKKI_EN_JSONL=/absolute/path/to/kaikki-en.jsonl
KAIKKI_VI_JSONL=/absolute/path/to/kaikki-vi.jsonl

# ============================================================
# IMPORT TARGET
# ============================================================

# Python PostgreSQL URL for importer tools (not JDBC format).
# scripts/init-dev-env.sh synchronizes this with the local PostgreSQL compose credentials/port.
DATABASE_URL=postgresql://lyreo:lyreo_dev_password@localhost:5432/lyreo_dev

# Optional: upload TOEIC media / imported pronunciation cache to R2.
# Leave empty during dry-run/local DB-only importer work.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lyreo-dev

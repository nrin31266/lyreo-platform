# Data importer environment is intentionally separate from Core Service runtime secrets.

# ============================================================
# GRAMMAR / TOEIC CLEAN RELEASE
# ============================================================

# Versioned package and installed directory. Relative paths resolve from tools/data-import/.
GRAMMAR_TOEIC_RELEASE_VERSION=2.0.12
GRAMMAR_TOEIC_RELEASE_SCHEMA_VERSION=1.0.0
GRAMMAR_TOEIC_RELEASE_DIR=../../.data/releases/grammar-toeic/2.0.12

# Canonical archive in the shared team Drive folder.
# file:// URLs and local archive paths also work. The checksum is pinned to the canonical archive.
GRAMMAR_TOEIC_RELEASE_URL=https://drive.google.com/file/d/1ZbgXuQA33zsaNC9SBFMraTdtiCMtiyVd/view
GRAMMAR_TOEIC_RELEASE_SHA256=10b090b40e1b69fff690f99e79f5e09711c3eb0c7bd422031676c98c1b7226ba

# Maintainer-only raw input for rebuilding a future release. Normal setup never fetches raw data.
GRAMMAR_TOEIC_RAW_DIR=../../.data/datasets/toeic

# ============================================================
# LEXICON CLEAN RELEASE
# ============================================================

# Versioned package and installed directory. Relative paths resolve from tools/data-import/.
LEXICON_RELEASE_VERSION=2.0.1
LEXICON_RELEASE_SCHEMA_VERSION=2.0.0
LEXICON_RELEASE_DIR=../../.data/releases/lexicon/2.0.1

# Canonical archive in the shared team Drive folder.
# file:// URLs and local archive paths also work. Pinned to canonical clean archive checksum.
LEXICON_RELEASE_URL=https://drive.google.com/file/d/1FcdLfF5cqmwl3U_et_jK-pHOcWW-cMCW/view
LEXICON_RELEASE_SHA256=ef183fa9cedc4bc2bd8f80b884116825f7735d3c7528acb30ceb9272a736972a

# Optional Kaikki inputs for the raw import diagnostic. Normal setup uses the pinned archive.
# KAIKKI_EN_JSONL=
# KAIKKI_VI_JSONL=

# ============================================================
# DRIVE AUTHENTICATION
# For private Drive, configure an rclone drive remote with your own authorized account.
# Leave empty for publicly readable Drive files. Private files need an authorized rclone remote.
DATA_DRIVE_REMOTE=

# IMPORT TARGET
# ============================================================

# Python PostgreSQL URL for importer tools (not JDBC format).
# scripts/init-dev-env.sh synchronizes this with the local PostgreSQL compose credentials/port.
DATABASE_URL=postgresql://lyreo:lyreo_dev_password@localhost:5432/lyreo_dev

# Local media uses the same root as Core (relative to tools/data-import/).
STORAGE_MODE=local
LOCAL_STORAGE_ROOT=../../.data/storage

# For shared R2 media set STORAGE_MODE=r2 explicitly. No automatic fallback.
# Each developer configures their own credentials locally; never commit the real .env.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lyreo-dev
R2_REGION=auto

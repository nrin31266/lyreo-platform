# Data importer environment is intentionally separate from Core Service runtime secrets.

# ============================================================
# GRAMMAR / TOEIC CLEAN RELEASE
# ============================================================

# Versioned package and installed directory. Relative paths resolve from tools/data-import/.
GRAMMAR_TOEIC_RELEASE_VERSION=1.0.1
GRAMMAR_TOEIC_RELEASE_SCHEMA_VERSION=1.0.0
GRAMMAR_TOEIC_RELEASE_DIR=../../.data/releases/grammar-toeic/1.0.1

# Fill in the Google Drive file-share URL after uploading grammar-toeic-1.0.1.tar.gz.
# file:// URLs and local archive paths also work. The checksum is pinned to the canonical archive.
GRAMMAR_TOEIC_RELEASE_URL=
GRAMMAR_TOEIC_RELEASE_SHA256=95f4bb9471e7b7b07f17ccec21a4434e25c18c9adf3dd3b28829eebe21c5adf0

# Maintainer-only raw input for rebuilding a future release. Normal setup never fetches raw data.
GRAMMAR_TOEIC_RAW_DIR=../../.data/datasets/toeic

# ============================================================
# LEXICON SOURCE DATA
# ============================================================

# Lexicon is a separate pipeline and has NOT been downloaded/scraped as part of the TOEIC dataset.
# Populate these only after obtaining the intended Kaikki/Wiktextract JSONL exports.
KAIKKI_EN_JSONL=/absolute/path/to/kaikki-en.jsonl
KAIKKI_VI_JSONL=/absolute/path/to/kaikki-vi.jsonl

# ============================================================
# IMPORT TARGET
# ============================================================

# Python PostgreSQL URL for importer tools (not JDBC format).
# scripts/init-dev-env.sh synchronizes this with the local PostgreSQL compose credentials/port.
DATABASE_URL=postgresql://lyreo:lyreo_dev_password@localhost:5432/lyreo_dev

# Optional: upload TOEIC media / imported pronunciation cache to R2.
# Leave empty during dry-run/local DB-only importer work.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lyreo-dev

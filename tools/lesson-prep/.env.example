# Lyreo Lesson Prep Tool environment. Copy to `.env`; never commit the real file.
# The tool is an operator/content-authoring tool, not a deployable backend.

# ============================================================
# AI SERVICE (capability execution)
# ============================================================
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_INTERNAL_TOKEN=change-me-local-internal-token

# ============================================================
# CORE API (canonical media + prepared source import)
# ============================================================
CORE_API_URL=http://localhost:8080

# ============================================================
# OIDC (Authorization Code + PKCE, public client lyreo-lesson-prep)
# ============================================================
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/lyreo
LESSON_PREP_CLIENT_ID=lyreo-lesson-prep
# Loopback IP literal per RFC 8252; realm also registers the localhost variant.
LESSON_PREP_REDIRECT_URI=http://127.0.0.1:7860/oidc/callback

# ============================================================
# TOOL WORKSPACE
# ============================================================
# Local working copies (extracted audio, previews). Canonical assets live in Core storage.
TOOL_WORK_DIR=.work

# Shared folder for exported *.lesson-source.json files (auto-created).
TOOL_EXPORT_DIR=exports

# Long AI calls (STT/alignment/TTS) may take minutes on CPU.
AI_TIMEOUT_SECONDS=600

# Extracted YouTube audio is normalized to mono WAV at this sample rate for STT.
YOUTUBE_AUDIO_SAMPLE_RATE=16000

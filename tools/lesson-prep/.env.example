# Lyreo Lesson Prep Tool environment. Copy to `.env`; never commit the real file.
# The tool is an operator/content-authoring workstation that exports portable
# *.lesson-source.zip packages. It does NOT require Core, Keycloak, PostgreSQL, or R2.

# ============================================================
# AI SERVICE (capability execution)
# ============================================================
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_INTERNAL_TOKEN=change-me-local-internal-token

# ============================================================
# TOOL WORKSPACE
# ============================================================
# Local isolated working runs (.work/<run-id>/)
TOOL_WORK_DIR=.work

# Folder for exported *.lesson-source.zip packages (auto-created).
TOOL_EXPORT_DIR=exports

# Long AI calls (STT/alignment/TTS) timeout in seconds.
AI_TIMEOUT_SECONDS=600

# Extracted YouTube audio is normalized to mono WAV at this sample rate for STT.
YOUTUBE_AUDIO_SAMPLE_RATE=16000
